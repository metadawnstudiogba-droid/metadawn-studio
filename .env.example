# Hosted edition only. The local edition creates its own encrypted workspace.

# Restricted pooled PostgreSQL connection for the seedance_runtime role.
DATABASE_URL=

# Independent random secrets. Do not reuse provider or R2 credentials.
SETTINGS_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
CRON_SECRET=

# Exact public HTTPS origin, without a path or trailing slash.
BETTER_AUTH_URL=https://studio.example.com

# Email verification and password reset delivery.
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@example.com
BREVO_FROM_NAME=Metadawn Studio

# Optional only when maintaining a reviewed restricted launch phase.
INITIAL_ADMIN_EMAIL=
